import { Pipe, PipeTransform } from '@angular/core';

@Pipe({
  name: 'hexFormat'
})
export class HexFormatPipe implements PipeTransform {
  transform(value: string): string {
    if (!value) return '00';
    return value
      .replace(/[^0-9A-Fa-f]/g, '')
      .match(/.{1,2}/g)
      ?.join(' ')
      .toUpperCase() || value;
  }
}


