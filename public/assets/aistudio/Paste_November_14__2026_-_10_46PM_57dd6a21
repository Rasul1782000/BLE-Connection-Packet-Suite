// ============================================================================
// 3. APPLICATION ENTRY POINT
// ============================================================================

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    println!("==================================================================");
    println!("[Monolith] Booting Bluetooth Connection & Packet Tracker Daemon");
    println!("==================================================================");

    // Initialize Host Bluetooth Manager & Primary Adapter
    let manager = Manager::new().await?;
    let adapters = manager.adapters().await?;
    let adapter = adapters
        .into_iter()
        .next()
        .ok_or("Fatal: No Bluetooth hardware adapter detected on host machine.")?;

    let adapter_info = adapter
        .adapter_info()
        .await
        .unwrap_or_else(|_| "Primary Host BLE Adapter".to_string());
    println!("[Hardware] Bound to adapter: {}", adapter_info);

    // Create Broadcast Channel for Real-Time Packet Telemetry
    let (tx, _rx) = broadcast::channel::<PacketTelemetry>(512);

    let shared_state = Arc::new(AppState {
        tx,
        adapter: adapter.clone(),
        adapter_name: adapter_info,
        tracked_devices: RwLock::new(HashMap::new()),
    });

    // Spawn Background BLE Packet Sniffer & Event Loop
    let scanner_state = Arc::clone(&shared_state);
    tokio::spawn(async move {
        if let Err(e) = run_ble_packet_engine(scanner_state).await {
            eprintln!("[BLE Engine Fatal Error]: {}", e);
        }
    });

    // Configure Monolithic HTTP REST & WebSocket Router
    let app = Router::new()
        .route("/api/health", get(health_check))
        .route("/api/devices", get(get_discovered_devices))
        .route("/api/connection", post(handle_connection_request))
        .route("/ws/packets", get(ws_packet_handler))
        .layer(CorsLayer::permissive())
        .with_state(shared_state);

    let bind_addr = "127.0.0.1:8080";
    let listener = tokio::net::TcpListener::bind(bind_addr).await?;
    println!("[Server] HTTP API active at http://{}", bind_addr);
    println!("[Server] WebSocket Stream active at ws://{}/ws/packets", bind_addr);

    axum::serve(listener, app).await?;
    Ok(())
}

// ============================================================================
// 4. BLUETOOTH PACKET CAPTURE & CONNECTION ENGINE
// ============================================================================

async fn run_ble_packet_engine(state: Arc<AppState>) -> Result<(), Box<dyn std::error::Error>> {
    state.adapter.start_scan(ScanFilter::default()).await?;
    println!("[BLE Engine] Active scanning started...");

    let mut events = state.adapter.events().await?;

    while let Some(event) = events.next().await {
        match event {
            CentralEvent::DeviceDiscovered(id) | CentralEvent::DeviceUpdated(id) => {
                if let Ok(peripheral) = state.adapter.peripheral(&id).await {
                    let props = peripheral.properties().await.unwrap_or(None);
                    let is_connected = peripheral.is_connected().await.unwrap_or(false);

                    let (name, mac, rssi, raw_hex) = if let Some(p) = props {
                        // Extract Manufacturer Specific Data bytes as Hex
                        let mut hex_bytes: Vec<String> = p
                            .manufacturer_data
                            .iter()
                            .flat_map(|(company_id, data)| {
                                let mut bytes = company_id.to_le_bytes().to_vec();
                                bytes.extend_from_slice(data);
                                bytes
                            })
                            .map(|b| format!("{:02X}", b))
                            .collect();

                        // Fallback to Service Data if Manufacturer Data is empty
                        if hex_bytes.is_empty() {
                            hex_bytes = p
                                .service_data
                                .values()
                                .flatten()
                                .map(|b| format!("{:02X}", b))
                                .collect();
                        }

                        let payload = if hex_bytes.is_empty() {
                            "02 01 06".to_string() // Standard BLE General Discoverable Flag
                        } else {
                            hex_bytes.join(" ")
                        };

                        (
                            p.local_name.unwrap_or_else(|| "Unnamed Peripheral".to_string()),
                            p.address.to_string(),
                            p.rssi.unwrap_or(-100),
                            payload,
                        )
                    } else {
                        ("Unknown Device".to_string(), id.to_string(), -100, "00".to_string())
                    };

                    // Preserve previously discovered GATT services if device is already cached
                    let existing_services = state
                        .tracked_devices
                        .read()
                        .await
                        .get(&id.to_string())
                        .map(|d| d.gatt_services.clone())
                        .unwrap_or_default();

                    let packet = PacketTelemetry {
                        packet_id: Uuid::new_v4().to_string(),
                        device_id: id.to_string(),
                        device_name: name,
                        mac_address: mac,
                        rssi,
                        packet_type: "ADV_IND".to_string(),
                        payload_hex: raw_hex,
                        gatt_services: existing_services,
                        is_connected,
                        timestamp: Utc::now(),
                    };

                    state
                        .tracked_devices
                        .write()
                        .await
                        .insert(id.to_string(), packet.clone());

                    let _ = state.tx.send(packet);
                }
            }
            CentralEvent::DeviceConnected(id) => {
                println!("[BLE Engine] Link established with {}", id);
                broadcast_state_packet(&state, &id.to_string(), "CONN_ESTABLISHED", true, None).await;
            }
            CentralEvent::DeviceDisconnected(id) => {
                println!("[BLE Engine] Link terminated with {}", id);
                broadcast_state_packet(&state, &id.to_string(), "CONN_TERMINATED", false, Some(vec![])).await;
            }
            _ => {}
        }
    }

    Ok(())
}

async fn broadcast_state_packet(
    state: &Arc<AppState>,
    device_id: &str,
    event_type: &str,
    connected: bool,
    updated_services: Option<Vec<String>>,
) {
    let mut devices = state.tracked_devices.write().await;
    if let Some(existing) = devices.get_mut(device_id) {
        existing.is_connected = connected;
        existing.packet_type = event_type.to_string();
        existing.timestamp = Utc::now();
        existing.packet_id = Uuid::new_v4().to_string();
        if let Some(services) = updated_services {
            existing.gatt_services = services;
        }
        let _ = state.tx.send(existing.clone());
    }
}

// ============================================================================
// 5. HTTP REST & WEBSOCKET HANDLERS
// ============================================================================

async fn health_check(State(state): State<Arc<AppState>>) -> Json<HealthStatus> {
    let count = state.tracked_devices.read().await.len();
    Json(HealthStatus {
        status: "OPERATIONAL".to_string(),
        adapter_info: state.adapter_name.clone(),
        cached_device_count: count,
        timestamp: Utc::now(),
    })
}

async fn get_discovered_devices(State(state): State<Arc<AppState>>) -> Json<Vec<PacketTelemetry>> {
    let devices = state.tracked_devices.read().await;
    let mut list: Vec<PacketTelemetry> = devices.values().cloned().collect();
    list.sort_by(|a, b| b.rssi.cmp(&a.rssi)); // Sort strongest signal first
    Json(list)
}

async fn handle_connection_request(
    State(state): State<Arc<AppState>>,
    Json(payload): Json<ConnectionRequestPayload>,
) -> (StatusCode, Json<ActionResponse>) {
    let peripherals = match state.adapter.peripherals().await {
        Ok(list) => list,
        Err(e) => {
            return (
                StatusCode::INTERNAL_SERVER_ERROR,
                Json(ActionResponse {
                    status: "ERROR".to_string(),
                    message: format!("Adapter peripheral query failed: {}", e),
                    device_id: payload.device_id,
                    discovered_services: vec![],
                }),
            )
        }
    };

    for peripheral in peripherals {
        if peripheral.id().to_string() == payload.device_id {
            match payload.action.to_uppercase().as_str() {
                "CONNECT" => {
                    println!("[API] Initiating GATT CONNECT request to {}", payload.device_id);
                    broadcast_state_packet(&state, &payload.device_id, "CONN_REQ_SENT", false, None).await;

                    match tokio::time::timeout(Duration::from_secs(10), peripheral.connect()).await {
                        Ok(Ok(_)) => {
                            let _ = peripheral.discover_services().await;
                            let services: Vec<String> = peripheral
                                .services()
                                .into_iter()
                                .map(|s| s.uuid.to_string())
                                .collect();

                            broadcast_state_packet(
                                &state,
                                &payload.device_id,
                                "CONN_ESTABLISHED",
                                true,
                                Some(services.clone()),
                            )
                            .await;

                            return (
                                StatusCode::OK,
                                Json(ActionResponse {
                                    status: "CONNECTED".to_string(),
                                    message: format!(
                                        "GATT connection established ({} services discovered)",
                                        services.len()
                                    ),
                                    device_id: payload.device_id,
                                    discovered_services: services,
                                }),
                            );
                        }
                        Ok(Err(e)) => {
                            return (
                                StatusCode::BAD_GATEWAY,
                                Json(ActionResponse {
                                    status: "REJECTED".to_string(),
                                    message: format!("Peripheral rejected connection: {}", e),
                                    device_id: payload.device_id,
                                    discovered_services: vec![],
                                }),
                            );
                        }
                        Err(_) => {
                            return (
                                StatusCode::GATEWAY_TIMEOUT,
                                Json(ActionResponse {
                                    status: "TIMEOUT".to_string(),
                                    message: "Connection handshake timed out after 10 seconds".to_string(),
                                    device_id: payload.device_id,
                                    discovered_services: vec![],
                                }),
                            );
                        }
                    }
                }
                "DISCONNECT" => {
                    println!("[API] Initiating DISCONNECT request for {}", payload.device_id);
                    match peripheral.disconnect().await {
                        Ok(_) => {
                            broadcast_state_packet(
                                &state,
                                &payload.device_id,
                                "CONN_TERMINATED",
                                false,
                                Some(vec![]),
                            )
                            .await;

                            return (
                                StatusCode::OK,
                                Json(ActionResponse {
                                    status: "DISCONNECTED".to_string(),
                                    message: "Peripheral disconnected cleanly".to_string(),
                                    device_id: payload.device_id,
                                    discovered_services: vec![],
                                }),
                            );
                        }
                        Err(e) => {
                            return (
                                StatusCode::INTERNAL_SERVER_ERROR,
                                Json(ActionResponse {
                                    status: "ERROR".to_string(),
                                    message: format!("Disconnect failed: {}", e),
                                    device_id: payload.device_id,
                                    discovered_services: vec![],
                                }),
                            );
                        }
                    }
                }
                _ => {
                    return (
                        StatusCode::BAD_REQUEST,
                        Json(ActionResponse {
                            status: "INVALID_ACTION".to_string(),
                            message: "Action must be CONNECT or DISCONNECT".to_string(),
                            device_id: payload.device_id,
                            discovered_services: vec![],
                        }),
                    );
                }
            }
        }
    }

    (
        StatusCode::NOT_FOUND,
        Json(ActionResponse {
            status: "NOT_FOUND".to_string(),
            message: "Target peripheral not found in active scan cache".to_string(),
            device_id: payload.device_id,
            discovered_services: vec![],
        }),
    )
}

async fn ws_packet_handler(
    ws: WebSocketUpgrade,
    State(state): State<Arc<AppState>>,
) -> impl IntoResponse {
    ws.on_upgrade(move |socket| handle_ws_client(socket, state))
}

async fn handle_ws_client(mut socket: WebSocket, state: Arc<AppState>) {
    let mut rx = state.tx.subscribe();
    while let Ok(packet) = rx.recv().await {
        if let Ok(json) = serde_json::to_string(&packet) {
            if socket.send(Message::Text(json)).await.is_err() {
                break;
            }
        }
    }
}


