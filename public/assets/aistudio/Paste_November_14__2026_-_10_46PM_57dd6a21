  loadingId: string | null = null;
  statusMessage = '';
  isError = false;

  constructor(private btService: BluetoothApiService) {}

  ngOnInit(): void {
    this.devices$ = this.btService.getTrackedDevices();
  }

  refresh(): void {
    this.btService.loadInitialDevices();
  }

  onActionRequested(event: { device: PacketTelemetry; action: 'CONNECT' | 'DISCONNECT' }): void {
    this.loadingId = event.device.device_id;
    this.isError = false;
    this.statusMessage = `Transmitting ${event.action} request to ${event.device.device_name}...`;

    this.btService.sendConnectionRequest(event.device.device_id, event.action).subscribe({
      next: (res) => {
        this.statusMessage = `[${res.status}] ${res.message}`;
        this.loadingId = null;
      },
      error: (err) => {
        this.isError = true;
        this.statusMessage = `[FAILED] ${err.error?.message || 'Connection request failed'}`;
        this.loadingId = null;
      },
    });
  }
}


