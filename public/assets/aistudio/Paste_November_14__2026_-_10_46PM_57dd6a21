export class PacketTrackerComponent implements OnInit, OnDestroy {
  allPackets: PacketTelemetry[] = [];
  filteredPackets: PacketTelemetry[] = [];
  isPaused = false;

  private searchTerm = '';
  private packetType = 'ALL';
  private sub!: Subscription;

  constructor(private btService: BluetoothApiService) {}

  ngOnInit(): void {
    this.sub = this.btService.getLivePackets().subscribe((pkt) => {
      if (this.isPaused) return;

      this.allPackets.unshift(pkt);
      if (this.allPackets.length > 250) {
        this.allPackets.pop();
      }
      this.applyFilter();
    });
  }

  onFilterChanged(filter: { searchTerm: string; packetType: string }): void {
    this.searchTerm = filter.searchTerm;
    this.packetType = filter.packetType;
    this.applyFilter();
  }

  applyFilter(): void {
    this.filteredPackets = this.allPackets.filter((pkt) => {
      const matchesType = this.packetType === 'ALL' || pkt.packet_type === this.packetType;
      const matchesSearch =
        !this.searchTerm ||
        pkt.device_name.toLowerCase().includes(this.searchTerm) ||
        pkt.mac_address.toLowerCase().includes(this.searchTerm) ||
        pkt.payload_hex.toLowerCase().includes(this.searchTerm);
      return matchesType && matchesSearch;
    });
  }

  togglePause(): void {
    this.isPaused = !this.isPaused;
  }

  clearLogs(): void {
    this.allPackets = [];
    this.filteredPackets = [];
  }

  ngOnDestroy(): void {
    if (this.sub) this.sub.unsubscribe();
  }
}


